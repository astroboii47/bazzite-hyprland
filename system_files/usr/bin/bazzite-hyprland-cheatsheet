#!/bin/bash
set -euo pipefail

text='SUPER + Enter     Terminal
SUPER + Space     App launcher
SUPER + E         Files
SUPER + Q         Close window
SUPER + F         Fullscreen
SUPER + V         Float window
SUPER + L         Lock
SUPER + N         Notifications
SUPER + C         Clipboard history
SUPER + W         Choose wallpaper
SUPER + comma     Choose theme
SUPER + Escape    Control sidebar
SUPER + 1–0       Change workspace
SUPER + Shift + 1–0  Move window
SUPER + arrows    Move focus
SUPER + CTRL + arrows  Resize active window
SUPER + ALT + D         Set and save display scale
3/4 finger swipe        Change workspace
4 finger swipe up       Workspace overview
4 finger swipe down     Quick settings
SUPER + drag            Move/resize window
Print             Screenshot
Shift + Print     Region screenshot'

if command -v kdialog >/dev/null; then
  kdialog --title "Hyprland shortcuts" --msgbox "$text"
else
  notify-send "Hyprland shortcuts" "$text"
fi
