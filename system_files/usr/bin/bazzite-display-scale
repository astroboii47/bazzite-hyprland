#!/usr/bin/bash
set -euo pipefail

store="${XDG_CONFIG_HOME:-$HOME/.config}/bazzite-hyprland/display-scales"

apply_saved() {
  [[ -f "$store" ]] || return 0
  while read -r output scale; do
    [[ -n "${output:-}" && -n "${scale:-}" ]] || continue
    hyprctl keyword monitor "$output,preferred,auto,$scale" >/dev/null
  done < "$store"
}

if [[ "${1:-}" == "--apply" ]]; then
  apply_saved
  exit 0
fi

output="$(hyprctl monitors -j | jq -r '.[] | select(.focused) | .name' | head -n1)"
[[ -n "$output" ]] || exit 1
choice="$(printf '%s\n' '0.80 · much smaller' '0.90 · smaller' '1.00 · normal' '1.10 · larger' '1.25 · much larger' | fuzzel --dmenu --prompt="  SCALE $output  /  ")" || exit 0
scale="${choice%% *}"

mkdir -p "$(dirname "$store")"
tmp="${store}.tmp"
if [[ -f "$store" ]]; then
  grep -v "^${output} " "$store" > "$tmp" || true
else
  : > "$tmp"
fi
printf '%s %s\n' "$output" "$scale" >> "$tmp"
mv "$tmp" "$store"
hyprctl keyword monitor "$output,preferred,auto,$scale" >/dev/null
