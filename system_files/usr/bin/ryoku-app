#!/bin/bash
set -euo pipefail

# Compatibility launcher for Ryoku's stock keybinds. The upstream Arch image
# provides this helper through its desktop package; Bazzite supplies Konsole as
# the installed terminal, so Super+Enter must resolve to it here.
case "${1:-}" in
  terminal)
    exec konsole
    ;;
  files)
    exec dolphin
    ;;
  browser)
    exec xdg-open 'https://www.google.com'
    ;;
  *)
    printf 'Ryoku app role is unavailable on this Bazzite image: %s\n' "${1:-}" >&2
    exit 2
    ;;
esac
