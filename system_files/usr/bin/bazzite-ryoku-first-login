#!/bin/bash
set -euo pipefail

walls="$HOME/Pictures/Wallpapers"
wall_config="$HOME/.config/ryogami-wall"
lock="$HOME/.local/share/quickshell-lockscreen"
themes="$HOME/.local/share/qylock/themes"

mkdir -p "$walls" "$wall_config" "$HOME/.local/share" "$HOME/.config/qylock" "$HOME/.config/hypr" "$HOME/.config/gtk-3.0"

# Matugen's templates live per-user. Earlier images shipped the controller but
# never seeded this tree, so no hypr-colors.lua was rendered and the focused
# border fell back to Ryoku's built-in red.
matugen_dir="$HOME/.config/matugen"
mkdir -p "$matugen_dir/templates" "$HOME/.cache/ryoku"
if [[ ! -f "$matugen_dir/config.toml" ]]; then
  cp /usr/share/ryoku-source/ryoku/shell/matugen/config.toml "$matugen_dir/config.toml"
fi
for template in /usr/share/ryoku-source/ryoku/shell/matugen/templates/*; do
  name="$(basename "$template")"
  [[ -e "$matugen_dir/templates/$name" ]] || cp -a "$template" "$matugen_dir/templates/$name"
done
# This template is owned by the image because it controls the shared active
# border role; refresh it so upgrades cannot retain the old secondary mapping.
cp /usr/share/ryoku-source/ryoku/shell/matugen/templates/hypr-colors.lua "$matugen_dir/templates/hypr-colors.lua"

# Install the real Ryoku configuration once per user.  The first prototype
# replaced this tree with a small independent config, so Hub settings, dynamic
# palette updates, plugins and cursor choices had no authoritative home.
hypr_config="$HOME/.config/hypr"
hypr_defaults="/usr/share/ryoku/hyprland-default"
hypr_marker="$hypr_config/.bazzite-ryoku-upstream"
refresh_hypr() {
  if [[ -e "$hypr_config/hyprland.lua" ]]; then
    backup="$hypr_config/hyprland.lua.before-ryoku-$(date +%Y%m%d-%H%M%S)"
    cp -a "$hypr_config/hyprland.lua" "$backup"
  fi
  cp -a "$hypr_defaults/hyprland.lua" "$hypr_config/hyprland.lua"
  # The prototype linked this file into /etc/xdg. Remove that link before the
  # directory copy so cp never follows it and attempts to write system files.
  rm -f "$hypr_config/modules/binds.lua"
  cp -a "$hypr_defaults/modules" "$hypr_config/"
  cp -a "$hypr_defaults/scripts" "$hypr_config/"
  for file in hypridle.conf xdph.conf monitors_user.lua.example; do
    cp -a "$hypr_defaults/$file" "$hypr_config/$file"
  done
  for file in keyboard.lua gpu.lua monitors.lua user.lua; do
    [[ -e "$hypr_config/$file" ]] || cp -a "$hypr_defaults/$file" "$hypr_config/$file"
  done
  touch "$hypr_marker"
}

if [[ "${1:-}" == "--refresh-hypr" || ! -e "$hypr_marker" ]]; then
  refresh_hypr
fi

# A prior image used a global action that is no longer provided by the real
# shell. Migrate only that exact stale wallpaper binding, leaving every other
# user keybind (including their chosen terminal shortcut) untouched.
binds_file="$hypr_config/modules/binds.lua"
if [[ -f "$binds_file" ]] && grep -Fq 'hl.dsp.global("ryoku:wallpaper-menu")' "$binds_file"; then
  sed -i 's|hl\.dsp\.global("ryoku:wallpaper-menu")|hl.dsp.exec_cmd("ryoku-shell menu wallpaper")|g' "$binds_file"
fi

# Route all display and audio media keys through the resident Ryoku controller.
# These substitutions are deliberately exact: they replace only the old direct
# commands, preserving any key the user has changed themselves. The controller
# is what feeds Ryoku's themed OSD for every volume, mute, and brightness press.
if [[ -f "$binds_file" ]]; then
  sed -i \
    -e 's|hl\.dsp\.exec_cmd("wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle")|hl.dsp.exec_cmd("ryoku-volume mute")|g' \
    -e 's|hl\.dsp\.exec_cmd("brightnessctl -e4 -n2 set 5%+")|hl.dsp.exec_cmd("ryoku-shell brightness up")|g' \
    -e 's|hl\.dsp\.exec_cmd("brightnessctl -e4 -n2 set 5%-")|hl.dsp.exec_cmd("ryoku-shell brightness down")|g' \
    -e 's|hl\.dsp\.exec_cmd("ryoku-cmd-brightness +5")|hl.dsp.exec_cmd("ryoku-shell brightness up")|g' \
    -e 's|hl\.dsp\.exec_cmd("ryoku-cmd-brightness -5")|hl.dsp.exec_cmd("ryoku-shell brightness down")|g' \
    "$binds_file"
  # Super+wheel is window sizing in this image. Replace only Ryoku's shipped
  # workspace-wheel rows; user-edited bindings remain untouched.
  sed -i \
    -e 's|hl\.bind(K(mod \.\. " + mouse_up"),[[:space:]]*hl\.dsp\.focus({ workspace = "r-1" }))|hl.bind(K(mod .. " + mouse_up"), hl.dsp.window.resize({ x = 40, y = 40, relative = true }), { repeating = true })|' \
    -e 's|hl\.bind(K(mod \.\. " + mouse_down"),[[:space:]]*hl\.dsp\.focus({ workspace = "r+1" }))|hl.bind(K(mod .. " + mouse_down"), hl.dsp.window.resize({ x = -40, y = -40, relative = true }), { repeating = true })|' \
    "$binds_file"
fi

# The early prototype placed gestures in /etc/xdg, but the real Ryoku config
# lives in the user's tree. Add the overview gesture there once so it remains
# active with the authoritative Ryoku session.
user_lua="$hypr_config/user.lua"
touch "$user_lua"
if ! grep -Fq 'bazzite-ryoku-four-finger-overview' "$user_lua"; then
  cat >> "$user_lua" <<'EOF'

-- bazzite-ryoku-four-finger-overview
hl.gesture({ fingers = 4, direction = "up", action = function()
  hl.dispatch(hl.dsp.global("ryoku:overview"))
end })
EOF
fi

# The Bazzite base also has Plasma's optional media-overlay processes. In a
# Hyprland login they can draw a second, unthemed OSD over Ryoku's own surface.
# Stop only the visual overlay processes in this login; a later Plasma login
# starts its normal shell again, so the KDE fallback remains intact.
if [[ "${XDG_CURRENT_DESKTOP:-}" == *Hyprland* ]]; then
  for overlay in plasmashell swayosd-server avizo-service xob; do
    pkill -x "$overlay" 2>/dev/null || true
  done
fi

# Ryoku's dock and launcher resolve desktop icons through the active GTK theme.
# Use the icon set its layouts were designed and tested with.
gsettings set org.gnome.desktop.interface icon-theme 'Papirus' 2>/dev/null || true
gsettings set org.gnome.desktop.interface cursor-size 18 2>/dev/null || true
cursor_theme="$(gsettings get org.gnome.desktop.interface cursor-theme 2>/dev/null | tr -d \"'\")"
if [[ "$cursor_theme" == "" || "$cursor_theme" == "default" || "$cursor_theme" == "Adwaita" ]]; then
  gsettings set org.gnome.desktop.interface cursor-theme 'Bibata-Modern-Ice' 2>/dev/null || true
fi
cursor_theme="$(gsettings get org.gnome.desktop.interface cursor-theme 2>/dev/null | tr -d \"'\")"
hyprctl setcursor "${cursor_theme:-Bibata-Modern-Ice}" 18 2>/dev/null || true
if [[ ! -s "$HOME/.config/gtk-3.0/settings.ini" ]]; then
  printf '%s\n' '[Settings]' 'gtk-icon-theme-name=Papirus' > "$HOME/.config/gtk-3.0/settings.ini"
elif grep -q '^gtk-icon-theme-name=' "$HOME/.config/gtk-3.0/settings.ini"; then
  sed -i 's/^gtk-icon-theme-name=.*/gtk-icon-theme-name=Papirus/' "$HOME/.config/gtk-3.0/settings.ini"
else
  printf '%s\n' 'gtk-icon-theme-name=Papirus' >> "$HOME/.config/gtk-3.0/settings.ini"
fi

# Seed Ryogami before its resident UI starts. Its own bootstrap normally does
# this, but an interrupted first launch otherwise leaves Super+W with no loaded
# configuration and therefore no visible picker.
if ! grep -q '"compositor"' "$wall_config/config.json" 2>/dev/null; then
  cp /usr/share/ryogami/data/config.json.example "$wall_config/config.json"
fi

# KDE starts this compatibility bridge globally. Hyprland uses its native
# portal, while the bridge appears as a fake recording app in Ryoku's dock.
mkdir -p "$HOME/.config/autostart"
cat > "$HOME/.config/autostart/org.kde.xwaylandvideobridge.desktop" <<'EOF'
[Desktop Entry]
Type=Application
Name=Xwayland Video Bridge
Hidden=true
EOF
pkill -x xwaylandvideobridge 2>/dev/null || true
if ! find "$walls" -maxdepth 1 -type f -print -quit | grep -q .; then
  cp -a /usr/share/ryoku/wallpapers/. "$walls/"
fi

# Refresh the program on every image revision so authentication and security
# fixes reach existing users. Themes and preferences live outside this folder.
rm -rf "$lock"
cp -a /usr/share/ryoku/lockscreen/qylock/quickshell-lockscreen "$lock"
chmod +x "$lock/lock.sh"

if [[ ! -d "$themes/clockwork/orbital" ]]; then
  mkdir -p "$themes/clockwork"
  cp -a /usr/share/ryoku/lockscreen/qylock/themes/clockwork/orbital "$themes/clockwork/"
fi
ln -sfn "$themes" "$lock/themes_link"
if [[ ! -s "$HOME/.config/qylock/theme" ]]; then
  printf '%s\n' 'clockwork/orbital' > "$HOME/.config/qylock/theme"
fi
if [[ ! -s "$HOME/.config/qylock/fingerprint" ]]; then
  printf '%s\n' 'on' > "$HOME/.config/qylock/fingerprint"
fi

# This image follows the wallpaper for its active outline. Remove only stale
# explicit border entries left by the early prototype or a prior Hub version.
if [[ -f "$hypr_config/settings.lua" ]]; then
  sed -i '/\["col\.active_border"\]/d; /\["col\.inactive_border"\]/d' "$hypr_config/settings.lua"
fi

# Ryotunes is a native QML client backed by a socket-activated playback daemon.
# Its Arch package preset is not applied when its payload is extracted into this
# immutable Fedora image, so enable the socket explicitly for this user. Without
# it the launcher has no daemon to connect to and exits without showing a window.
systemctl --user daemon-reload
systemctl --user enable --now ryotunesd.socket
