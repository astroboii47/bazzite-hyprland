[Unit]
Description=Ryoku floating desktop shell
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Environment=RYOKU_SHELL_DIR=/usr/share/ryoku-source/ryoku/shell
Environment=QML2_IMPORT_PATH=/usr/lib/qt6/qml
Environment=RYOKU_POLKIT_AGENT=1
ExecStartPre=-/usr/bin/ryoku-shell quit
# Apply safe, exact migrations to an existing Ryoku user configuration before
# the shell reads it. Image updates otherwise change only /usr while the active
# ~/.config/hypr copy keeps stale bindings and gestures indefinitely.
ExecStartPre=/usr/bin/bazzite-ryoku-first-login
# The shell's wallpaper renderer requires these per-user Matugen templates.
# Seed them before the daemon starts rather than relying on a particular
# Hyprland configuration callback, which older user configurations may omit.
ExecStartPre=/usr/bin/bazzite-ryoku-matugen-bootstrap
ExecStart=/usr/bin/ryoku-shell daemon
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
