#!/bin/sh
# Broadcom ControlVault readers can remain present on USB after suspend while
# their firmware session is no longer usable. Restart fprintd only after wake so
# the lockscreen can talk to the enrolled reader again.
case "$1/$2" in
  post/*)
    # The reader can appear on USB before its ControlVault firmware session is
    # ready. Waiting for the resumed udev queue removes the race that made a
    # one-second delay work only intermittently after opening the lid.
    /usr/bin/udevadm settle --timeout=8 || true
    sleep 2
    /usr/bin/systemctl try-restart fprintd.service
    ;;
esac
